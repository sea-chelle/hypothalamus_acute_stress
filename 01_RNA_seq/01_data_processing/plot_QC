# set working directory to plots
setwd(here("plots"))

# create a df of total counts for each sample
library_df <- data.frame(Sample = names(colSums(counts(dds))), TotalCounts = colSums(counts(dds)))
library_df$Sample <- sub("\\..*$", "", library_df$Sample) # keep animal number only in sample ID name

# plot library size for each sample
ggplot(library_df, aes(x = Sample, y = TotalCounts)) +
  geom_bar(stat = "identity", fill = "#A995C9") +
  scale_y_continuous(expand = expansion(mult = c(0, 0.05))) +
  labs(title = "Total counts per sample", y = "Total counts") +
  theme_classic() +
  theme(plot.title = element_text(hjust = 0.5, size = 11),
        axis.title.x = element_blank(),
        axis.title.y = element_text(size = 9),
        axis.text.x = element_text(angle = 90, size = 8),
        axis.text.y = element_text(size = 8),
