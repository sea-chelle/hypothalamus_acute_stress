# combine PCA by sex and restraint for PC 1 and 2 
PCA_sex | PCA_restraint
ggsave("figB.2_PCA1and2_sex_restraint.tiff", height = 4.5, width = 6)

# calculate euclidean distance between samples
sample_dists <- dist(t(vsd_mat))
sample_dists <- as.matrix(sample_dists)

# extract sample ID only from column names
original_names <- colnames(sample_dists)
sample_ids <- sub("\\..*", "", original_names)

# apply sample ID names to distance matrix
colnames(sample_dists) <- sample_ids
rownames(sample_dists) <- sample_ids

# create annotation dataframe
split_info <- do.call(rbind, strsplit(original_names, "\\."))
annotation_df <- data.frame(Sex = split_info[, 2], Condition = split_info[, 3])
rownames(annotation_df) <- sample_ids

# definte annotation colours
ha <- HeatmapAnnotation(df = annotation_df,
                        col = list(Sex = c("f" = "#D78FA9", "m" = "#78A8D1"), 
                                   Condition = c("basal" = "#A995C9", "10" = "#5FA9A2", "60" = "#DD805E")), 
                        annotation_name_side = "left")


# plot heatmap
ht <- Heatmap(sample_dists,
              name = "Distance",
              col = colorRamp2(c(min(sample_dists), max(sample_dists)), c("#fff7ec", "#D9364A")),
              cluster_rows = TRUE,
              cluster_columns = TRUE,
              top_annotation = HeatmapAnnotation(df = annotation_df,
                                                 col = list(Sex = c("f" = "#D78FA9", "m" = "#78A8D1"),
                                                            Condition = c("basal" = "#A995C9", "10" = "#5FA9A2", "60" = "#DD805E")),
                                                 annotation_name_side = "left",
                                                 annotation_name_gp = gpar(fontsize = 8),
                                                 annotation_legend_param = list(Sex = list(title_gp = gpar(fontsize = 7),
                                                                                           labels_gp = gpar(fontsize = 7)),
                                                                                Condition = list(title_gp = gpar(fontsize = 7),
                                                                                                 labels_gp = gpar(fontsize = 7)))),
              show_row_names = TRUE,
              show_column_names = TRUE,
              row_names_gp = gpar(fontsize = 8),
              column_names_gp = gpar(fontsize = 8),
              column_title = "Sample-to-Sample Distance",
              column_title_gp = gpar(fontsize = 9),
              width = unit(12, "cm"),
              height = unit(12, "cm"),
              heatmap_legend_param = list(title = "Euclidean Distance",
                                          title_gp = gpar(fontsize = 7),
                                          labels_gp = gpar(fontsize = 7)))

# plot heatmap
png("figB.3_sample_heatmap.png", height = 1900, width = 2000, res = 300)
draw(ht,
    merge_legends = TRUE)
dev.off()
