ggsave("figB.1_library_sizes.tiff", height = 2.5, width = 6, dpi = 600, compression = "lzw")


# turn VST-normalised counts into a matrix
vsd_mat <- assay(vsd)

# run PCA before batch correction
pca_before_batch <- prcomp(t(vsd_mat), scale. = FALSE)

# calculate variance explained by each PC
percentVar_before <- pca_before_batch$sdev^2 / sum(pca_before_batch$sdev^2) * 100
percentVar_before[1:2]

# get batch from vst object
batch <- colData(vsd)$batch

# create a df from pca results
pca_before_batch_df <- as.data.frame(pca_before_batch$x)

# add metadata to df
pca_before_batch_df$sex <- colData(dds)$sex
pca_before_batch_df$condition <- colData(dds)$condition
pca_before_batch_df$batch <- colData(dds)$batch
pca_before_batch_df$ID <- colData(dds)$ID
pca_before_batch_df$sample <- rownames(colData(dds))
pca_before_batch_df$group <- paste(pca_before_batch_df$sex, pca_before_batch_df$condition, sep = ":")

# add which samples to label on plot
pca_before_batch_df$label <- ifelse(pca_before_batch_df$ID %in% c("2097", "1034", "832", "831", "1045"),
                                    pca_before_batch_df$ID,
                                    "")

# plot PCA by batch before batch correction
PCA_before_batch <- ggplot(pca_before_batch_df, aes(x = PC1, y = PC2, color = batch)) +
  geom_point(size = 1.5) +
  geom_text_repel(aes(label = label), 
                  size = 2, 
                  color = "black", 
                  max.overlaps = Inf) +
  labs(title = "Before batch correction",
       x = paste0("PC1 (", sprintf("%.1f", percentVar_before[1]), "%)"),
       y = paste0("PC2 (", sprintf("%.1f", percentVar_before[2]), "%)"),
       color = "Batch") +
  scale_color_manual(values = c("may_2025" = "#A995C9",
                                "nov_2025" = "#5FA9A2"),
                     labels = c("may_2025" = "May 2025",
                                "nov_2025" = "November 2025")) +
  theme_bw() +
  theme(plot.title = element_text(hjust = 0.5, size = 9),
        axis.title = element_text(size = 8),
        axis.text = element_text(size = 8),
        legend.title = element_text(size = 7),
        legend.text = element_text(size = 7),
        legend.key.size = unit(0.4, "cm"),
        legend.box.spacing = unit(0, "pt"),
        panel.grid.major = element_blank(),
        panel.grid.minor = element_blank())
ggsave(plot = PCA_before_batch, "fig4.1a_pca_before_batch.pdf", height = 3, width = 4.5, dpi = 300)

# batch-correct transformed data
vsd_mat <- removeBatchEffect(vsd_mat, batch = batch)

# run PCA on batch-corrected data
pca_after_batch <- prcomp(t(vsd_mat), scale. = FALSE)

# calculate varianced explained by each PC
percentVar_after <- pca_after_batch$sdev^2 / sum(pca_after_batch$sdev^2) * 100
percentVar_after[1:2]

# create a df from pca results
pca_after_batch_df <- as.data.frame(pca_after_batch$x)

# add metadata to df
pca_after_batch_df$sex <- colData(dds)$sex
pca_after_batch_df$condition <- colData(dds)$condition
pca_after_batch_df$batch <- colData(dds)$batch
pca_after_batch_df$ID <- colData(dds)$ID
pca_after_batch_df$sample <- rownames(colData(dds))
pca_after_batch_df$group <- paste(pca_after_batch_df$sex, pca_after_batch_df$condition, sep = ":")

